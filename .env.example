# ==========================================
# 1. APPLICATION & SERVER CONFIGURATION
# ==========================================
# The port number on which the Express server will listen
PORT=5289

# Environment mode: 'development' | 'production' | 'test'
NODE_ENV=development


# ==========================================
# 2. DATABASE CONFIGURATION (MongoDB Atlas / Prisma)
# ==========================================
# MongoDB connection URI (Atlas or local)
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/<database_name>?retryWrites=true&w=majority&appName=Cluster0"


# ==========================================
# 3. SECURITY & BCRYPT CONFIGURATION
# ==========================================
# Salt rounds used by bcrypt for hashing passwords (10-12 recommended)
PASSWORD_SALT=10


# ==========================================
# 4. JWT (JSON WEB TOKEN) CONFIGURATION
# ==========================================
# Secret key used to sign and verify Access Tokens
JWT_SECRET="your_super_secret_jwt_access_key_here"

# Access token expiration duration (e.g. '15m', '1d', '7d')
JWT_EXPIRES_IN="7d"

# Secret key used to sign and verify Refresh Tokens
JWT_REFRESH_SECRET="your_super_secret_jwt_refresh_key_here"

# Refresh token expiration duration (e.g. '30d', '60d')
JWT_REFRESH_EXPIRES_IN="30d"


# ==========================================
# 5. SMTP / EMAIL SERVICE CONFIGURATION (OTP & Password Reset)
# ==========================================
# SMTP server host (e.g. smtp.gmail.com | smtp.mailgun.org | smtp.sendgrid.net)
SMTP_HOST=smtp.gmail.com

# SMTP port: 587 for STARTTLS or 465 for SSL
SMTP_PORT=587

# Sender email address
SMTP_USER="your-email@gmail.com"

# SMTP app password (For Gmail: Google Account -> Security -> 2-Step Verification -> App Passwords)
SMTP_PASS="your_16_character_app_password"

# Sender display name & email formatted as "Name <email@domain.com>"
SMTP_FROM="Diamond Pay <no-reply@diamondpay.com>"


# ==========================================
# 6. AWS S3 STORAGE CONFIGURATION
# ==========================================
AWS_ACCESS_KEY_ID="your_aws_access_key_id"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"
AWS_REGION="ap-southeast-2"
AWS_BUCKET_NAME="diamond-pay-storage"


# ==========================================
# 7. AI MICROSERVICE CONFIGURATION
# ==========================================
# Remote AI service URL (FastAPI microservice for Image, Video, Music generation & Audio enhance)
AI_SERVICE_URL="http://206.162.244.175:4444"

# Timeout in milliseconds for AI requests (Default: 180000 = 3 minutes)
AI_SERVICE_TIMEOUT_MS=180000


# ==========================================
# 8. FIREBASE AUTH CONFIGURATION (Google & Apple Login)
# ==========================================
# Path to Firebase Service Account JSON file (recommended for VPS / Docker)
FIREBASE_SERVICE_ACCOUNT_PATH="./firebase-service-account.json"

# Alternatively, pass the raw JSON string (useful for Cloud platforms like Vercel, Railway, Render)
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type": "service_account", "project_id": "...", ...}'

# Firebase Project credentials (optional fallback)
FIREBASE_PROJECT_ID="rachel-nguet"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-fbsvc@rachel-nguet.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"


# ==========================================
# 9. REVENUECAT SUBSCRIPTION CONFIGURATION
# ==========================================
# Optional: Secret header configured in RevenueCat Dashboard Webhooks (for webhook signature verification)
REVENUECAT_WEBHOOK_AUTH_HEADER="your_revenuecat_webhook_secret_bearer_or_token"

# RevenueCat REST API v1/v2 key (for server-to-server subscription verification if needed)
REVENUECAT_API_KEY="your_revenuecat_api_key"


# ==========================================
# 10. CLOUDINARY CONFIGURATION (Optional fallback storage)
# ==========================================
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
