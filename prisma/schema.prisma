generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String        @unique
  password     String?
  avatar       String?
  role         Role          @default(user)
  status       Status        @default(active)
  authProvider AuthProvider  @default(email)
  googleId     String?
  appleId      String?
  firebaseUid  String?

  isVerified            Boolean           @default(false)

  // Subscription fields
  subscriptionTier      SubscriptionTier  @default(FREE)
  isSubscribed          Boolean           @default(false)
  subscriptionExpiresAt DateTime?

  designs               Design[]
  subscriptions         Subscription[]
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
}

enum AuthProvider {
  email
  google
  apple
}

enum Status {
  active
  inactive
  blocked
}

enum Role {
  user
  admin
}

model Otp {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  email     String
  otp       String
  type      OtpType   @default(REGISTRATION)
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([email, type])
}

enum OtpType {
  REGISTRATION
  FORGOT_PASSWORD
}

model Design {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  userId       String      @db.ObjectId
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  imageUrl     String
  mediaType    MediaType   @default(IMAGE)
  publicId     String?
  fileSize     Int?
  mimeType     String?
  type         DesignType  @default(UPLOADED)
  prompt       String?
  duration     Int?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([userId, createdAt])
  @@index([userId, mediaType])
}

enum DesignType {
  UPLOADED
  AI_GENERATED
}

enum MediaType {
  IMAGE
  VIDEO
  MUSIC
  AUDIO
}

model Subscription {
  id                     String             @id @default(auto()) @map("_id") @db.ObjectId
  userId                 String             @db.ObjectId
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalAppUserId      String?
  appUserId              String
  productId              String
  entitlementId          String?
  tier                   SubscriptionTier   @default(FREE)
  status                 SubscriptionStatus @default(ACTIVE)
  store                  String?            // APP_STORE, PLAY_STORE, STRIPE, etc.
  environment            String?            // SANDBOX, PRODUCTION
  price                  Float?
  currency               String?            @default("USD")
  periodType             String?
  purchasedAt            DateTime?
  expiresAt              DateTime?
  cancelledAt            DateTime?
  unsubscribeDetectedAt DateTime?
  isTrial                Boolean            @default(false)
  rawEvent               String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([userId, status])
  @@index([appUserId])
}

enum SubscriptionTier {
  FREE
  BASIC
  STANDARD
  PREMIUM
  DESIGN_PRO
}

enum SubscriptionStatus {
  ACTIVE
  TRIAL
  EXPIRED
  CANCELLED
  PAUSED
  BILLING_ISSUE
}





